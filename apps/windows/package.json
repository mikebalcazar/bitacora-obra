{
  "name": "bitacora-obra-windows",
  "version": "0.1.0",
  "private": true,
  "description": "t101pano para Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "mx.forespot.bitacoraobra",
    "productName": "t101pano",
    "directories": { "output": "salida" },
    "files": ["main.js", "dist/**"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
